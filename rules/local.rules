# Local defensive Suricata rules.
# These rules only generate alerts. They do not send traffic.

alert http any any -> any any (msg:"LOCAL LAB - OTP keyword in URI"; http.uri; content:"otp"; nocase; sid:9000001; rev:1;)
alert http any any -> any any (msg:"LOCAL LAB - verification keyword in URI"; http.uri; content:"verify"; nocase; sid:9000002; rev:1;)
alert http any any -> any any (msg:"LOCAL LAB - SMS keyword in URI"; http.uri; content:"sms"; nocase; sid:9000003; rev:1;)
